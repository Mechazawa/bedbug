{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "Bas Bieling"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "at.ioexception.mcaddon.McAddon"
    ],
    "client": [
      "at.ioexception.mcaddon.client.McAddonClient"
    ],
    "fabric-gametest": [
      "at.ioexception.mcaddon.gametest.AddonGameTests",
      "at.ioexception.mcaddon.gametest.SurfaceGameTests",
      "at.ioexception.mcaddon.gametest.PackGameTests",
      "at.ioexception.mcaddon.gametest.BehaviourGameTests",
      "at.ioexception.mcaddon.gametest.ComponentGameTests",
      "at.ioexception.mcaddon.gametest.StructureGameTests",
      "at.ioexception.mcaddon.gametest.PlayerGameTests",
      "at.ioexception.mcaddon.gametest.CommandGameTests",
      "at.ioexception.mcaddon.gametest.NamesGameTests",
      "at.ioexception.mcaddon.gametest.ScriptGameTests"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "suggests": {
    "modmenu": "*"
  },
  "depends": {
    "fabricloader": ">=${fabric_loader}",
    "minecraft": "${mc_range}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
