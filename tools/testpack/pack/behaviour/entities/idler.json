{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "tp:idler",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "tp:started": {
          "type": "bool",
          "default": false
        },
        "tp:ended": {
          "type": "bool",
          "default": false
        }
      }
    },
    "component_groups": {
      "tp:idler_timing": {
        "minecraft:behavior.timer_flag_1": {
          "priority": 0,
          "duration_range": {
            "min": 2,
            "max": 2
          },
          "cooldown_range": {
            "min": 3,
            "max": 3
          },
          "control_flags": [
            "look"
          ],
          "on_start": {
            "event": "tp:idler_started",
            "target": "self"
          },
          "on_end": {
            "event": "tp:idler_ended",
            "target": "self"
          }
        }
      },
      "tp:idler_sitting": {
        "minecraft:behavior.random_sitting": {
          "priority": 0,
          "start_chance": 1,
          "stop_chance": 1,
          "min_sit_time": 2,
          "cooldown": 3
        }
      },
      "tp:idler_lying": {
        "minecraft:behavior.lay_down": {
          "priority": 0,
          "interval": 4,
          "random_stop_interval": 1
        }
      },
      "tp:idler_bedridden": {
        "minecraft:behavior.lay_down": {
          "priority": 0,
          "interval": 1,
          "random_stop_interval": 1000000
        }
      },
      "tp:idler_looking": {
        "minecraft:behavior.random_look_around_and_sit": {
          "priority": 0,
          "probability": 1,
          "min_look_count": 4,
          "max_look_count": 4,
          "min_look_time": 10,
          "max_look_time": 10,
          "min_angle_of_view_horizontal": -30,
          "max_angle_of_view_horizontal": 30,
          "random_look_around_cooldown": 2
        }
      },
      "tp:idler_napping": {
        "minecraft:behavior.nap": {
          "priority": 0,
          "cooldown_min": 2,
          "cooldown_max": 2,
          "mob_detect_dist": 4,
          "mob_detect_height": 2,
          "can_nap_filters": {
            "test": "is_family",
            "subject": "self",
            "value": "tp_idler"
          }
        }
      },
      "tp:idler_insomniac": {
        "minecraft:behavior.nap": {
          "priority": 0,
          "can_nap_filters": {
            "test": "is_family",
            "subject": "self",
            "value": "pig"
          }
        }
      },
      "tp:idler_unbothered": {
        "minecraft:behavior.nap": {
          "priority": 0,
          "mob_detect_dist": 4,
          "mob_detect_height": 2,
          "wake_mob_exceptions": {
            "test": "is_family",
            "subject": "other",
            "value": "pig"
          }
        }
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "tp_idler",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.0
      },
      "minecraft:health": {
        "value": 20,
        "max": 20
      },
      "minecraft:movement": {
        "value": 0.25
      },
      "minecraft:physics": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {},
      "minecraft:jump.static": {}
    },
    "events": {
      "tp:idler_make_timing": {
        "add": {
          "component_groups": [
            "tp:idler_timing"
          ]
        }
      },
      "tp:idler_make_sitting": {
        "add": {
          "component_groups": [
            "tp:idler_sitting"
          ]
        }
      },
      "tp:idler_make_lying": {
        "add": {
          "component_groups": [
            "tp:idler_lying"
          ]
        }
      },
      "tp:idler_make_bedridden": {
        "add": {
          "component_groups": [
            "tp:idler_bedridden"
          ]
        }
      },
      "tp:idler_make_looking": {
        "add": {
          "component_groups": [
            "tp:idler_looking"
          ]
        }
      },
      "tp:idler_make_napping": {
        "add": {
          "component_groups": [
            "tp:idler_napping"
          ]
        }
      },
      "tp:idler_make_insomniac": {
        "add": {
          "component_groups": [
            "tp:idler_insomniac"
          ]
        }
      },
      "tp:idler_make_unbothered": {
        "add": {
          "component_groups": [
            "tp:idler_unbothered"
          ]
        }
      },
      "tp:idler_started": {
        "set_property": {
          "tp:started": true
        }
      },
      "tp:idler_ended": {
        "set_property": {
          "tp:ended": true
        }
      }
    }
  }
}
