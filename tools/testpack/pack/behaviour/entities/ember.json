    "events": {
      "tp:ember_kindle": {
        "set_property": {
          "tp:kindled": true
        }
      },
      "tp:ember_glow": {
        "set_property": {
          "tp:glowing": true
        }
      },
      "tp:ember_saddle": {
        "add": {
          "component_groups": ["tp:ember_saddled"]
        }
      },
      "tp:ember_unsaddle": {
        "remove": {
          "component_groups": ["tp:ember_saddled"]
        }
      },
      "tp:ember_grow_young": {
        "add": {
          "component_groups": ["tp:ember_young"]
        }
      },
      "tp:ember_shrink": {
        "add": {
          "component_groups": ["tp:ember_small"]
        }
      },
      "tp:ember_unshrink": {
        "remove": {
          "component_groups": ["tp:ember_small"]
        }
      },
      "tp:ember_mature": {
        "add": {
          "component_groups": ["tp:ember_grown"]
        }
      },
      "tp:ember_enrage": {
        "add": {
          "component_groups": ["tp:ember_fierce"]
        }
      },
      "tp:ember_soothe": {
        "remove": {
          "component_groups": ["tp:ember_fierce"]
        }
      },
      "tp:ember_provoke": {
        "add": {
          "component_groups": ["tp:ember_angry"]
        }
      },
      "tp:ember_calmed": {
        "remove": {
          "component_groups": ["tp:ember_angry"]
        },
        "set_property": {
          "tp:calmed": true
        }
      },
      "tp:ember_alert_on": {
        "add": {
          "component_groups": ["tp:ember_alert"]
        }
      },
      "tp:ember_alert_off": {
        "remove": {
          "component_groups": ["tp:ember_alert"]
        },
        "set_property": {
          "tp:timed": false,
          "tp:sensed": false
        }
      },
      "tp:ember_time_up": {
        "set_property": {
          "tp:timed": true
        }
      },
      "tp:ember_sensed": {
        "set_property": {
          "tp:sensed": true
        }
      },
      "tp:ember_load": {
        "add": {
          "component_groups": ["tp:ember_laden"]
        }
      },
      "tp:ember_unload": {
        "remove": {
          "component_groups": ["tp:ember_laden"]
        }
      },
      "tp:ember_sat": {
        "set_property": {
          "tp:sat": true
        }
      },
      "tp:ember_prime": {
        "add": {
          "component_groups": ["tp:ember_primed"]
        }
      },
      "tp:ember_ward_on": {
        "add": {
          "component_groups": ["tp:ember_warded"]
        }
      },
      "tp:ember_scratched": {
        "set_property": {
          "tp:scratched": true
        }
      },
      "tp:ember_look_for_saddle": {
        "filters": {
          "test": "has_component",
          "subject": "self",
          "value": "minecraft:is_saddled"
        },
        "set_property": {
          "tp:saddle_seen": true
        }
      }
