{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "tp:ember",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "tp:kindled": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "tp:glowing": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "tp:saddle_seen": {
          "type": "bool",
          "default": false,
          "client_sync": true
        }
      },
      "animations": {
        "kindle": "animation.tp.ember.kindle",
        "kindle_controller": "controller.animation.tp.ember.kindle"
      },
      "scripts": {
        "animate": [
          "kindle_controller"
        ]
      }
    },
    "components": {
      "minecraft:type_family": {
        "family": [
          "tp_ember",
          "mob"
        ]
      },
      "minecraft:collision_box": {
        "width": 0.4,
        "height": 0.4
      },
      "minecraft:health": {
        "value": 4,
        "max": 4
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:fire_immune": true,
      "minecraft:physics": {},
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {},
      "minecraft:jump.static": {},
      "minecraft:behavior.random_stroll": {
        "priority": 5,
        "speed_multiplier": 1.2
      },
      "minecraft:equipment": {
        "table": "loot_tables/entities/ember_equipment.json",
        "slot_drop_chance": [
          {
            "slot": "slot.armor.head",
            "drop_chance": 1.0
          }
        ]
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/ember.json"
      },
      "minecraft:trade_table": {
        "display_name": "Ember",
        "table": "trading/ember_trades.json"
      },
      "minecraft:behavior.trade_with_player": {
        "priority": 2
      },
      "minecraft:behavior.trade_interest": {
        "priority": 3,
        "within_radius": 6.0,
        "interest_time": 45,
        "remove_item_time": 1,
        "carried_item_switch_time": 2,
        "cooldown": 2
      },
      "minecraft:variable_max_auto_step": {
        "base_value": 1.0
      },
      "minecraft:flying_speed": {
        "value": 0.25
      }
    },
    "component_groups": {
      "tp:ember_saddled": {
        "minecraft:is_saddled": {}
      },
      "tp:ember_young": {
        "minecraft:ageable": {
          "duration": 1200,
          "grow_up": {
            "event": "tp:ember_kindle",
            "target": "self"
          }
        }
      }
    },
    "events": {
      "tp:ember_kindle": {
        "set_property": {
          "tp:kindled": true
        }
      },
      "tp:ember_glow": {
        "set_property": {
          "tp:glowing": true
        }
      },
      "tp:ember_saddle": {
        "add": {
          "component_groups": ["tp:ember_saddled"]
        }
      },
      "tp:ember_unsaddle": {
        "remove": {
          "component_groups": ["tp:ember_saddled"]
        }
      },
      "tp:ember_grow_young": {
        "add": {
          "component_groups": ["tp:ember_young"]
        }
      },
      "tp:ember_look_for_saddle": {
        "filters": {
          "test": "has_component",
          "subject": "self",
          "value": "minecraft:is_saddled"
        },
        "set_property": {
          "tp:saddle_seen": true
        }
      }
    }
  }
}
