{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.tp.ember.kindle": {
      "initial_state": "cold",
      "states": {
        "cold": {
          "transitions": [
            { "kindling": "query.is_alive" }
          ]
        },
        "kindling": {
          "on_entry": [
            "variable.kindled = 1;",
            "@s tp:ember_kindle",
            "/tag @s[r=1] add tp_kindled"
          ],
          "animations": [ "kindle" ],
          "transitions": [
            { "lit": "query.all_animations_finished" }
          ]
        },
        "lit": {
          "on_entry": [
            "variable.lit = 1;"
          ]
        }
      }
    },
    "controller.animation.tp.perch.settle": {
      "initial_state": "seated",
      "states": {
        "seated": {
          "on_entry": [
            "variable.settled_tier = variable.rider_tier ?? -1;"
          ],
          "animations": [
            { "journeyman": "variable.settled_tier == 2" }
          ],
          "transitions": [
            { "settled": "1" }
          ]
        },
        "settled": {
          "on_entry": [
            "/tag @s add tp_perch_settled"
          ]
        }
      }
    }
  }
}
