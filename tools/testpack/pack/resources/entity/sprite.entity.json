{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "tp:sprite",
      "min_engine_version": "1.16.0",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/sprite"
      },
      "geometry": {
        "default": "geometry.tp.sprite",
        "young": "geometry.tp.sprite.young",
        "cap": "geometry.tp.sprite.cap"
      },
      "animations": {
        "idle": "animation.tp.sprite.idle",
        "chime": "animation.tp.sprite.chime"
      },
      "scripts": {
        "pre_animation": ["v.bob = math.sin(q.life_time * 90) * 0.5;"],
        "animate": ["idle", {"chime": "q.is_alive"}]
      },
      "sound_effects": {
        "ping": "tp:sprite.chime"
      },
      "particle_effects": {
        "twinkle": "tp:sparkle",
        "pop": "tp:burst"
      },
      "render_controllers": [
        "controller.render.tp.sprite",
        "controller.render.tp.sprite.cap"
      ],
      "enable_attachables": true,
      "held_item_scale": 2.0,
      "held_item_ignores_lighting": true,
      "spawn_egg": {
        "texture": "eggs",
        "texture_index": 1
      }
    }
  }
}
