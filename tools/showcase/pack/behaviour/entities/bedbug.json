{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "bb:bedbug",
      "is_spawnable": true,
      "is_summonable": true
    },
    "component_groups": {
      "bb:chestnut": {"minecraft:variant": {"value": 0}},
      "bb:rose": {"minecraft:variant": {"value": 1}},
      "bb:plum": {"minecraft:variant": {"value": 2}}
    },
    "components": {
      "minecraft:type_family": {"family": ["bedbug", "arthropod", "mob"]},
      "minecraft:collision_box": {"width": 0.8, "height": 0.5},
      "minecraft:scale": {"value": 1.3},
      "minecraft:health": {"value": 8, "max": 8},
      "minecraft:movement": {"value": 0.18},
      "minecraft:physics": {},
      "minecraft:pushable": {"is_pushable": true, "is_pushable_by_piston": true},
      "minecraft:nameable": {},
      "minecraft:navigation.walk": {"can_walk": true, "avoid_water": true},
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:behavior.float": {"priority": 0},
      "minecraft:behavior.panic": {"priority": 1, "speed_multiplier": 1.6},
      "minecraft:behavior.tempt": {"priority": 2, "speed_multiplier": 1.1, "items": ["bb:honey_bun"]},
      "minecraft:home": {"restriction_radius": 3},
      "minecraft:behavior.move_towards_home_restriction": {"priority": 3, "speed_multiplier": 1.0},
      "minecraft:behavior.random_stroll": {"priority": 4, "speed_multiplier": 1.0, "interval": 40, "xz_dist": 2, "y_dist": 1},
      "minecraft:behavior.look_at_player": {"priority": 6, "look_distance": 6.0, "probability": 0.02},
      "minecraft:behavior.random_look_around": {"priority": 7}
    },
    "events": {
      "minecraft:entity_spawned": {
        "randomize": [
          {"weight": 1, "add": {"component_groups": ["bb:chestnut"]}},
          {"weight": 1, "add": {"component_groups": ["bb:rose"]}},
          {"weight": 1, "add": {"component_groups": ["bb:plum"]}}
        ]
      },
      "bb:become_chestnut": {
        "remove": {"component_groups": ["bb:rose", "bb:plum"]},
        "add": {"component_groups": ["bb:chestnut"]}
      },
      "bb:become_rose": {
        "remove": {"component_groups": ["bb:chestnut", "bb:plum"]},
        "add": {"component_groups": ["bb:rose"]}
      },
      "bb:become_plum": {
        "remove": {"component_groups": ["bb:chestnut", "bb:rose"]},
        "add": {"component_groups": ["bb:plum"]}
      }
    }
  }
}
