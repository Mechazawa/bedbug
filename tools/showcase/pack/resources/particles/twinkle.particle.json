{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "bb:twinkle",
      "basic_render_parameters": {
        "material": "particles_alpha",
        "texture": "textures/particle/showcase_particles"
      }
    },
    "curves": {
      "variable.glimmer": {
        "type": "catmull_rom",
        "input": "v.particle_age / v.particle_lifetime",
        "horizontal_range": 1.0,
        "nodes": [0.0, 0.0, 1.0, 0.6, 0.0, 0.0]
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {"spawn_rate": 30, "max_particles": 80},
      "minecraft:emitter_lifetime_looping": {"active_time": 3.0},
      "minecraft:emitter_shape_disc": {
        "offset": [0, 0.3, 0],
        "radius": 1.3,
        "plane_normal": "y",
        "surface_only": false,
        "direction": [0, 1, 0]
      },
      "minecraft:particle_initial_speed": "math.random(0.1, 0.35)",
      "minecraft:particle_lifetime_expression": {"max_lifetime": "math.random(1.0, 1.8)"},
      "minecraft:particle_motion_dynamic": {"linear_acceleration": [0, 0.05, 0], "linear_drag_coefficient": 0.6},
      "minecraft:particle_appearance_billboard": {
        "size": ["0.1 + v.glimmer * 0.18", "0.1 + v.glimmer * 0.18"],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texturewidth": 64,
          "textureheight": 64,
          "flipbook": {
            "base_UV": [0, 0],
            "size_UV": [8, 8],
            "step_UV": [8, 0],
            "frames_per_second": 6,
            "max_frame": 4,
            "stretch_to_lifetime": true,
            "loop": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFF2B0",
            "0.5": "#FFFFB0D8",
            "1.0": "#FFB8A8FF"
          }
        }
      }
    }
  }
}
